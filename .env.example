# =================================================
# HOME-E-FIX ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit real secret keys or production secrets to source control.

# ==========================================
# HOME-E-FIX CORE
# ==========================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Home-e-Fix
NEXT_PUBLIC_APP_URL=http://localhost:5173
BUSINESS_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR

# ==========================================
# SUPABASE (PostgreSQL, Auth & Realtime)
# ==========================================
# Client-side safe variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side ONLY (Supabase Edge Function / Cloudflare Worker secrets)
# NEVER expose service role key to frontend or client bundle
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Auth Send SMS Hook Secret (for verifying Svix webhook signature)
SUPABASE_SMS_HOOK_SECRET=whsec_your_hook_secret_here
SEND_SMS_HOOK_SECRET=whsec_your_hook_secret_here

# ==========================================
# RAZORPAY (Primary & Only Payment Gateway)
# ==========================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ==========================================
# GOOGLE MAPS PLATFORM
# ==========================================
VITE_MAP_API_KEY=your_google_maps_browser_key
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_api_key
GOOGLE_MAPS_MAP_ID=your_google_maps_map_id

# ==========================================
# LOCATION / TRACKING ENGINE
# ==========================================
LOCATION_TRACKING_ENABLED=true
LOCATION_UPDATE_INTERVAL_MS=5000
LOCATION_MIN_DISTANCE_METERS=10
LOCATION_SESSION_MAX_MINUTES=240
ETA_REFRESH_INTERVAL_SECONDS=30

# ==========================================
# TRANSACTIONAL EMAIL (Resend)
# ==========================================
RESEND_API_KEY=re_your_resend_api_key
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret
EMAIL_FROM_NAME=Home-e-Fix
EMAIL_FROM_ADDRESS=notifications@home-e-fix.com
SUPPORT_EMAIL=support@home-e-fix.com

# ==========================================
# BOT PROTECTION (Cloudflare Turnstile)
# ==========================================
VITE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
TURNSTILE_SECRET=your_cloudflare_turnstile_secret_key
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key
TURNSTILE_HOSTNAMES=home-e-fix.vercel.app
TURNSTILE_ENABLED=true
TURNSTILE_ENVIRONMENT=production

# ==========================================
# AI ASSISTANT (Gemini / OpenRouter)
# ==========================================
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ==========================================
# OBSERVABILITY & TELEMETRY (Sentry)
# ==========================================
SENTRY_DSN=
VITE_SENTRY_DSN=

# ==========================================
# FEATURE FLAGS
# ==========================================
FEATURE_RAZORPAY=true
FEATURE_GOOGLE_AUTH=true
FEATURE_PHONE_OTP=false
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_AI=true
FEATURE_EMERGENCY_BOOKING=true
FEATURE_LIVE_TRACKING=true
FEATURE_PLUS=true
FEATURE_WARRANTY=true

# ==========================================
# PHONE OTP & 2FACTOR SMS AUTHENTICATION
# ==========================================
# AUTH_SMS_MODE: 'development' or 'production'
# - development: Zero real SMS sent, zero cost, logs masked delivery to server console.
# - production: Dispatches real SMS through 2Factor using DLT-approved template.
# HARD SAFETY CHECK: If NODE_ENV === 'production', AUTH_SMS_MODE CANNOT be 'development' (fails closed).
AUTH_SMS_MODE=development
SMS_PROVIDER=2factor

# 2Factor SMS Gateway (Server-Side ONLY - Supabase Edge Function / Cloudflare Worker secret)
# NEVER commit or expose to frontend client components
TWOFACTOR_API_KEY=your_2factor_api_key_here
TWOFACTOR_TEMPLATE_ID=HOME_E_FIX_LOGIN
TWOFACTOR_SENDER_ID=HEFFIX

# DLT / Indian Telecom Entity ID (if required by 2Factor route)
SMS_ENTITY_ID=

# Rate Limiting & Cooldowns
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_OTP_REQUESTS=5
OTP_REQUEST_WINDOW_MINUTES=15
MAX_VERIFY_ATTEMPTS=5

# ==========================================
# CLOUDFLARE INFRASTRUCTURE
# ==========================================
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Supabase Storage KYC Configuration
# KYC bucket MUST remain strictly private (public = false).
SUPABASE_KYC_BUCKET=professional-kyc

# ==========================================
# SERVICE & BUSINESS PROFILE
# ==========================================
VITE_BUSINESS_NAME="Home-e-Fix"
VITE_BUSINESS_GSTIN="" # Optional: Leave empty if GST threshold exemption applies
VITE_SAC_CODE="998719" # Maintenance and repair services of domestic electrical/electronic equipment

# ==========================================
# ADMIN ACCESS & BOOTSTRAP
# ==========================================
# User UUID of platform owner for one-time server-side bootstrap
ADMIN_BOOTSTRAP_USER_ID=your-admin-user-uuid
VITE_ADMIN_BOOTSTRAP_USER_ID=your-admin-user-uuid
