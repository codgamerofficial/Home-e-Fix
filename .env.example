# ============================================================
# HOME-E-FIX ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and provide your actual production / staging credentials.
# NEVER commit real secret keys to source control.

# ─── 1. Supabase PostgreSQL Database & Auth (Authoritative Source of Truth) ───
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-backend-only-service-role-key
VITE_SUPABASE_AUTH_CALLBACK_URL=https://your-domain.com/auth/callback

# ─── 2. Application Core & API Gateway ───
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=/api
MODE=development

# ─── 3. Payment Gateway (Razorpay) ───
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── 4. Geolocation & Maps (Google Maps / MapmyIndia) ───
VITE_MAP_API_KEY=your_google_maps_browser_key
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key
VITE_MAPMYINDIA_MAP_API_KEY=your_mappls_api_key
VITE_MAPMYINDIA_CLIENT_ID=your_mappls_client_id

# ─── 5. Authentication Providers ───
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ─── 6. Transactional Notifications (Email / SMS / WhatsApp) ───
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Home-e-Fix Notifications <orders@home-e-fix.com>
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
MSG91_AUTH_KEY=your_msg91_auth_key
WHATSAPP_BUSINESS_API_TOKEN=your_whatsapp_token
