# =================================================
# HOME-E-FIX ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit real secret keys or production secrets to source control.

# ==========================================
# HOME-E-FIX CORE
# ==========================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Home-e-Fix
NEXT_PUBLIC_APP_URL=http://localhost:5173
BUSINESS_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR

# ==========================================
# SUPABASE (PostgreSQL, Auth & Realtime)
# ==========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Supabase Auth Send SMS Hook Secret (Edge Function secret, NEVER expose to client)
SEND_SMS_HOOK_SECRET=whsec_your_hook_secret_here

# ==========================================
# RAZORPAY (Primary & Only Payment Gateway)
# ==========================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ==========================================
# GOOGLE MAPS PLATFORM
# ==========================================
VITE_MAP_API_KEY=your_google_maps_browser_key
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_api_key
GOOGLE_MAPS_MAP_ID=your_google_maps_map_id

# ==========================================
# LOCATION / TRACKING ENGINE
# ==========================================
LOCATION_TRACKING_ENABLED=true
LOCATION_UPDATE_INTERVAL_MS=5000
LOCATION_MIN_DISTANCE_METERS=10
LOCATION_SESSION_MAX_MINUTES=240
ETA_REFRESH_INTERVAL_SECONDS=30

# ==========================================
# TRANSACTIONAL EMAIL (Resend)
# ==========================================
RESEND_API_KEY=re_your_resend_api_key
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret
EMAIL_FROM_NAME=Home-e-Fix
EMAIL_FROM_ADDRESS=notifications@home-e-fix.com
SUPPORT_EMAIL=support@home-e-fix.com

# ==========================================
# BOT PROTECTION (Cloudflare Turnstile)
# ==========================================
VITE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
TURNSTILE_SECRET=your_cloudflare_turnstile_secret_key
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key
TURNSTILE_HOSTNAMES=home-e-fix.vercel.app
TURNSTILE_ENABLED=true
TURNSTILE_ENVIRONMENT=production

# ==========================================
# AI ASSISTANT (Gemini / OpenRouter)
# ==========================================
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ==========================================
# OBSERVABILITY & TELEMETRY (Sentry)
# ==========================================
SENTRY_DSN=
VITE_SENTRY_DSN=

# ==========================================
# FEATURE FLAGS
# ==========================================
FEATURE_RAZORPAY=true
FEATURE_GOOGLE_AUTH=true
FEATURE_PHONE_OTP=false
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_AI=true
FEATURE_EMERGENCY_BOOKING=true
FEATURE_LIVE_TRACKING=true
FEATURE_PLUS=true
FEATURE_WARRANTY=true

# ==========================================
# PROFESSIONAL PHONE OTP & KYC VERIFICATION
# ==========================================
# OTP Provider Mode: 'development' or 'production'
# - development: Cryptographic 6-digit numeric OTP, SHA-256 hashed, 5m expiry, 45s resend cooldown.
# - production: Dispatches SMS via server-side Edge Function / SMS Gateway.
# HARD SAFETY CHECK: If NODE_ENV === 'production', OTP_PROVIDER_MODE cannot be 'development'.
OTP_PROVIDER_MODE=development
VITE_OTP_PROVIDER_MODE=development

OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# Production SMS Gateway (Server-Side / Supabase Edge Function ONLY)
# DO NOT expose SMS API keys or secrets in frontend client code.
SMS_GATEWAY_URL=https://api.sms-gateway-india.com/v1/send
SMS_GATEWAY_API_KEY=your_sms_provider_api_key
SMS_GATEWAY_SENDER_ID=HEFFIX
SMS_GATEWAY_DLT_TEMPLATE_ID=your_dlt_template_id

# Supabase Storage KYC Configuration
# KYC bucket MUST remain strictly private (public = false).
SUPABASE_KYC_BUCKET=professional-kyc
