# =================================================
# HOME-E-FIX ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================
# Copy this file to .env or .env.local and set your real credentials.
# NEVER commit real secret keys to source control.

# Application Information
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Home-e-Fix
NEXT_PUBLIC_APP_URL=http://localhost:5173
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# ─── Supabase PostgreSQL & Auth ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_AUTH_CALLBACK_URL=http://localhost:5173/auth/v1/callback

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Razorpay Payment Gateway ───
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Cashfree Payment Gateway (Secondary) ───
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret
CASHFREE_API_VERSION=2025-01-01

# ─── Google Maps Platform ───
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key
VITE_MAP_API_KEY=your_google_maps_browser_key
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_restricted_key
GOOGLE_MAPS_MAP_ID=your_map_id

# ─── Google OAuth ───
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Transactional Email (Resend) ───
RESEND_API_KEY=re_your_resend_api_key
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret
EMAIL_FROM_NAME=Home-e-Fix
EMAIL_FROM_ADDRESS=notifications@home-e-fix.com
SUPPORT_EMAIL=support@home-e-fix.com

# ─── Push Notifications (Firebase) ───
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key

# ─── AI Assistant (Gemini & OpenRouter) ───
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ─── Bot Protection (Cloudflare Turnstile) ───
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ─── Observability (Sentry) ───
SENTRY_DSN=your_sentry_dsn
NEXT_PUBLIC_SENTRY_DSN=your_public_sentry_dsn

# ─── Marketplace Operational Configuration ───
BUSINESS_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR
BOOKING_ASSIGNMENT_TIMEOUT_SECONDS=45
PROFESSIONAL_LOCATION_UPDATE_INTERVAL_SECONDS=15
EMERGENCY_MAX_ETA_MINUTES=120
ADDITIONAL_CHARGE_REQUIRES_CUSTOMER_APPROVAL=true

# ─── Feature Flags ───
FEATURE_RAZORPAY=true
FEATURE_CASHFREE=false
FEATURE_GOOGLE_AUTH=true
FEATURE_PHONE_OTP=true
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_AI=true
FEATURE_EMERGENCY_BOOKING=true
FEATURE_LIVE_TRACKING=true
FEATURE_PLUS=true
FEATURE_WARRANTY=true
